# The Hawking Fly — neuPrint/MaleCNS credentials
# Copy to `.env` and fill in. `.env` is gitignored; never commit a real token.

# Personal neuPrint API token (free account + key at https://neuprint.janelia.org)
NEUPRINT_TOKEN=

# Primary connectome dataset (MaleCNS v1.0 — whole male CNS, brain+optic
# lobes+VNC, one animal). Alternate neuPrint datasets: "hemibrain:v1.0.1",
# "manc:v1.2.1"
NEUPRINT_DATASET=male-cns:v1.0
NEUPRINT_SERVER=https://neuprint.janelia.org

# neuPrint cannot be queried without a token. The connectome client fails
# gracefully (NoTokenError) and Phase 0A proceeds with flyvis-only validation
# until this value is set.